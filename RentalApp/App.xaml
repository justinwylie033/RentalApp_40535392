<?xml version="1.0" encoding="utf-8" ?>
<Application xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="RentalApp.App">
    <Application.Resources>
        <ResourceDictionary>
            <Color x:Key="Primary">#1D4ED8</Color>
            <Color x:Key="PrimaryDark">#1E3A8A</Color>
            <Color x:Key="PrimaryLight">#DBEAFE</Color>
            <Color x:Key="Accent">#0F766E</Color>
            <Color x:Key="Surface">#F6F8FC</Color>
            <Color x:Key="TextPrimary">#172033</Color>
            <Color x:Key="TextSecondary">#5C667A</Color>
            <Color x:Key="Border">#D7DEEA</Color>
            <Color x:Key="Success">#15803D</Color>
            <Color x:Key="SuccessLight">#DCFCE7</Color>
            <Color x:Key="Danger">#B91C1C</Color>
            <Color x:Key="DangerLight">#FEE2E2</Color>

            <Style TargetType="ContentPage">
                <Setter Property="BackgroundColor" Value="{StaticResource Surface}" />
            </Style>
            <Style TargetType="Label">
                <Setter Property="TextColor" Value="{StaticResource TextPrimary}" />
                <Setter Property="FontSize" Value="15" />
            </Style>
            <Style TargetType="Entry">
                <Setter Property="TextColor" Value="{StaticResource TextPrimary}" />
                <Setter Property="BackgroundColor" Value="White" />
                <Setter Property="HeightRequest" Value="48" />
                <Setter Property="Margin" Value="0,3" />
                <Setter Property="ClearButtonVisibility" Value="WhileEditing" />
            </Style>
            <Style TargetType="Editor">
                <Setter Property="TextColor" Value="{StaticResource TextPrimary}" />
                <Setter Property="BackgroundColor" Value="White" />
            </Style>
            <Style TargetType="Picker">
                <Setter Property="TextColor" Value="{StaticResource TextPrimary}" />
                <Setter Property="BackgroundColor" Value="White" />
                <Setter Property="HeightRequest" Value="48" />
            </Style>
            <Style TargetType="Button">
                <Setter Property="BackgroundColor" Value="{StaticResource Primary}" />
                <Setter Property="TextColor" Value="White" />
                <Setter Property="CornerRadius" Value="10" />
                <Setter Property="HeightRequest" Value="48" />
                <Setter Property="Padding" Value="16,10" />
                <Setter Property="FontAttributes" Value="Bold" />
            </Style>
            <Style x:Key="PageTitle" TargetType="Label">
                <Setter Property="FontSize" Value="30" />
                <Setter Property="FontAttributes" Value="Bold" />
                <Setter Property="TextColor" Value="{StaticResource PrimaryDark}" />
            </Style>
            <Style x:Key="SectionTitle" TargetType="Label">
                <Setter Property="FontSize" Value="20" />
                <Setter Property="FontAttributes" Value="Bold" />
                <Setter Property="TextColor" Value="{StaticResource PrimaryDark}" />
            </Style>
            <Style x:Key="InputLabel" TargetType="Label">
                <Setter Property="FontSize" Value="13" />
                <Setter Property="FontAttributes" Value="Bold" />
                <Setter Property="TextColor" Value="{StaticResource TextSecondary}" />
            </Style>
            <Style x:Key="ErrorLabel" TargetType="Label">
                <Setter Property="TextColor" Value="{StaticResource Danger}" />
                <Setter Property="FontSize" Value="13" />
            </Style>
            <Style x:Key="SuccessLabel" TargetType="Label">
                <Setter Property="TextColor" Value="{StaticResource Success}" />
                <Setter Property="FontAttributes" Value="Bold" />
                <Setter Property="FontSize" Value="13" />
            </Style>
            <Style x:Key="MutedLabel" TargetType="Label">
                <Setter Property="TextColor" Value="{StaticResource TextSecondary}" />
                <Setter Property="FontSize" Value="13" />
            </Style>
            <Style x:Key="Card" TargetType="Border">
                <Setter Property="BackgroundColor" Value="White" />
                <Setter Property="Stroke" Value="{StaticResource Border}" />
                <Setter Property="StrokeThickness" Value="1" />
                <Setter Property="StrokeShape" Value="RoundRectangle 14" />
                <Setter Property="Padding" Value="16" />
                <Setter Property="Margin" Value="0,6" />
            </Style>
            <Style x:Key="SecondaryButton" TargetType="Button">
                <Setter Property="BackgroundColor" Value="White" />
                <Setter Property="TextColor" Value="{StaticResource Primary}" />
                <Setter Property="BorderColor" Value="{StaticResource Primary}" />
                <Setter Property="BorderWidth" Value="1" />
                <Setter Property="CornerRadius" Value="10" />
                <Setter Property="HeightRequest" Value="48" />
                <Setter Property="Padding" Value="16,10" />
                <Setter Property="FontAttributes" Value="Bold" />
            </Style>
            <Style x:Key="DangerButton" TargetType="Button">
                <Setter Property="BackgroundColor" Value="{StaticResource Danger}" />
                <Setter Property="TextColor" Value="White" />
                <Setter Property="CornerRadius" Value="10" />
                <Setter Property="HeightRequest" Value="48" />
                <Setter Property="Padding" Value="16,10" />
                <Setter Property="FontAttributes" Value="Bold" />
            </Style>
            <Style x:Key="CompactButton" TargetType="Button">
                <Setter Property="BackgroundColor" Value="{StaticResource Primary}" />
                <Setter Property="TextColor" Value="White" />
                <Setter Property="CornerRadius" Value="9" />
                <Setter Property="HeightRequest" Value="40" />
                <Setter Property="Padding" Value="12,7" />
                <Setter Property="FontAttributes" Value="Bold" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
