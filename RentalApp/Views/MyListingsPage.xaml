<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="RentalApp.Views.MyListingsPage"
             Title="My listings">
    <Grid Padding="18" RowDefinitions="Auto,Auto,*" RowSpacing="12">
        <VerticalStackLayout>
            <Label Text="My listings" Style="{StaticResource PageTitle}"
                   SemanticProperties.HeadingLevel="Level1" />
            <Label Text="Manage everything you have offered to the community."
                   Style="{StaticResource MutedLabel}" />
        </VerticalStackLayout>

        <VerticalStackLayout Grid.Row="1" Spacing="4">
            <Label Text="{Binding ErrorMessage}" Style="{StaticResource ErrorLabel}" />
            <ActivityIndicator IsRunning="{Binding IsBusy}"
                               IsVisible="{Binding IsBusy}"
                               Color="{StaticResource Primary}" />
        </VerticalStackLayout>

        <CollectionView Grid.Row="2"
                        ItemsSource="{Binding Items}"
                        EmptyView="You have not listed any items yet.">
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Border Style="{StaticResource Card}">
                        <Grid RowDefinitions="Auto,Auto,Auto" ColumnDefinitions="*,Auto" RowSpacing="7">
                            <Label Text="{Binding Title}" FontSize="19" FontAttributes="Bold" />
                            <Label Grid.Column="1"
                                   Text="{Binding DailyRate, StringFormat='£{0:F2}/day'}"
                                   FontAttributes="Bold"
                                   TextColor="{StaticResource PrimaryDark}" />
                            <Label Grid.Row="1" Text="{Binding Category}" Style="{StaticResource MutedLabel}" />
                            <Label Grid.Row="1" Grid.Column="1" Text="{Binding IsAvailable, StringFormat='Available: {0}'}" />
                            <Button Grid.Row="2"
                                    Grid.ColumnSpan="2"
                                    Text="Manage listing"
                                    SemanticProperties.Hint="Open this listing to edit its details and availability"
                                    Style="{StaticResource SecondaryButton}"
                                    Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.OpenItemCommand}"
                                    CommandParameter="{Binding .}" />
                        </Grid>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </Grid>
</ContentPage>
