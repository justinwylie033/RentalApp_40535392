# Copy this file to .env and replace both secrets before production deployment.
POSTGRES_DB=rentalapp
POSTGRES_USER=rentalapp
POSTGRES_PASSWORD=replace-with-a-long-random-database-password
JWT_SECRET=replace-with-a-random-secret-containing-at-least-32-characters
JWT_ISSUER=RentalApp.Api
JWT_AUDIENCE=RentalApp.Maui
JWT_ACCESS_TOKEN_MINUTES=30
JWT_REFRESH_TOKEN_DAYS=14
API_PORT=8080
